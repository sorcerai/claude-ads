{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-marketing-hub:claude-ads:schema:control:v1:target-evidence.v1.json",
  "title": "Claude Ads normalized target resolver evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "evidence_class", "resolved_at", "source_date_epoch", "source_report_sha256", "source_pip_version", "source_environment", "normalization_notes", "environment", "resolver", "platform_policy", "components"],
  "if": {"properties": {"evidence_id": {"pattern": "^development-windows-cp31[12]$"}}},
  "then": {"required": ["supplemental_report"]},
  "else": {"not": {"required": ["supplemental_report"]}},
  "properties": {
    "schema_version": {"const": "1.0.0"}, "evidence_id": {"type": "string", "minLength": 1},
    "evidence_class": {"const": "cross-target-pip-resolution-requiring-native-ci-confirmation"},
    "resolved_at": {"const": "2026-10-01T01:02:22Z"}, "source_date_epoch": {"const": 1790816542},
    "source_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_pip_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"},
    "supplemental_report": {
      "type": "object", "additionalProperties": false,
      "required": ["source_report_sha256", "target", "component"],
      "properties": {
        "source_report_sha256": {"const": "51a45ce89d8675e2e47279c9e8876e886e8b2f264aee83a2f6b78f9fa552c849"},
        "target": {"type": "object", "additionalProperties": false, "required": ["implementation", "python_version", "abi", "platform", "require_hashes", "only_binary"], "properties": {"implementation": {"const": "cp"}, "python_version": {"enum": ["3.11", "3.12"]}, "abi": {"enum": ["cp311", "cp312"]}, "platform": {"const": "win_amd64"}, "require_hashes": {"const": true}, "only_binary": {"const": ":all:"}}},
        "component": {"type": "object", "additionalProperties": false, "required": ["name", "version", "artifact"], "properties": {"name": {"const": "colorama"}, "version": {"const": "0.4.6"}, "artifact": {"type": "object", "additionalProperties": false, "required": ["filename", "url", "sha256"], "properties": {"filename": {"const": "colorama-0.4.6-py2.py3-none-any.whl"}, "url": {"type": "string", "pattern": "^https://files.pythonhosted.org/"}, "sha256": {"const": "4f1d9991f5acc0ca119f9d443620b77f9d6b33703e51011c16baf57afb285fc6"}}}}}
      }
    },
    "source_environment": {"type": "object"}, "normalization_notes": {"type": "array", "items": {"type": "string"}},
    "environment": {"type": "object"}, "resolver": {"const": "pip / PyPI"},
    "platform_policy": {"const": "Exact lowest-common lock with target-selected PyPI wheels"},
    "components": {"type": "array", "minItems": 1}
  }
}
