{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-marketing-hub:claude-ads:schema:core:v2:data-lifecycle.schema.json",
  "title": "DataLifecycle v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lifecycle_id", "classification", "retention", "encryption", "access", "deletion", "incident"],
  "$defs": {
    "contained_path": {
      "type": ["string", "null"],
      "pattern": "^(?![\\s\\S]*\\u0000)(?=[\\s\\S]*\\S)(?!\\.{1,2}(?:/|$))[^/\\\\]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\]+)*$"
    }
  },
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "lifecycle_id": {"$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v1:workflow-common.schema.json#/$defs/id"},
    "classification": {"$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v1:workflow-common.schema.json#/$defs/privacy"},
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_seconds", "mode", "delete_after", "purpose", "exception_reason"],
      "properties": {
        "minimum_seconds": {"type": "integer", "minimum": 0},
        "mode": {"enum": ["ephemeral", "operator-defined", "policy-defined", "exception", "unassigned"]},
        "delete_after": {"type": ["string", "null"], "format": "date-time"},
        "purpose": {"$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v1:workflow-common.schema.json#/$defs/nonempty"},
        "exception_reason": {"type": ["string", "null"]}
      }
    },
    "encryption": {
      "type": "object", "additionalProperties": false,
      "required": ["at_rest", "in_transit", "evidence_refs"],
      "properties": {
        "at_rest": {"enum": ["unknown", "verified", "not-applicable"]},
        "in_transit": {"enum": ["unknown", "verified", "not-applicable"]},
        "evidence_refs": {
          "$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v1:workflow-common.schema.json#/$defs/string_array",
          "items": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "access": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "authorized_roles", "access_log_locator"],
      "properties": {
        "owner": {"$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v1:workflow-common.schema.json#/$defs/nonempty"},
        "authorized_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v1:workflow-common.schema.json#/$defs/nonempty"}},
        "access_log_locator": {"$ref": "#/$defs/contained_path"}
      }
    },
    "deletion": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "method", "verification_required", "verification_artifact_locator", "scheduler_receipt_locator"],
      "properties": {
        "status": {"enum": ["pending", "scheduled", "verified", "exception"]},
        "method": {"$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v1:workflow-common.schema.json#/$defs/nonempty"},
        "verification_required": {"const": true},
        "verification_artifact_locator": {"$ref": "#/$defs/contained_path"},
        "scheduler_receipt_locator": {"$ref": "#/$defs/contained_path"}
      }
    },
    "incident": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "reporting_channel", "status", "record_locator"],
      "properties": {
        "owner": {"$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v1:workflow-common.schema.json#/$defs/nonempty"},
        "reporting_channel": {"$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v1:workflow-common.schema.json#/$defs/nonempty"},
        "status": {"enum": ["not-triggered", "open", "contained", "resolved"]},
        "record_locator": {"$ref": "#/$defs/contained_path"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"retention": {"properties": {"mode": {"const": "unassigned"}}}}},
      "then": {"properties": {"retention": {"properties": {"delete_after": {"type": "null"}}}}}
    },
    {
      "if": {"properties": {"deletion": {"properties": {"status": {"const": "scheduled"}}}}},
      "then": {"properties": {"deletion": {"properties": {"scheduler_receipt_locator": {"type": "string"}}}}}
    },
    {
      "if": {"properties": {"deletion": {"properties": {"status": {"const": "verified"}}}}},
      "then": {"properties": {"deletion": {"properties": {"verification_artifact_locator": {"type": "string"}}}}}
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"encryption": {"properties": {"at_rest": {"const": "verified"}}}}},
          {"properties": {"encryption": {"properties": {"in_transit": {"const": "verified"}}}}}
        ]
      },
      "then": {"properties": {"encryption": {"properties": {"evidence_refs": {"minItems": 1}}}}}
    }
  ]
}
