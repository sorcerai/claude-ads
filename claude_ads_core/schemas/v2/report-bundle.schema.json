{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-marketing-hub:claude-ads:schema:core:v2:report-bundle.schema.json",
  "title": "ReportBundle v2",
  "type": "object",
  "required": ["schema_version", "run_manifest", "account_snapshot", "control_definitions", "findings", "scoring"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "run_manifest": {"$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v1:run-manifest.schema.json"},
    "account_snapshot": {"$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v2:account-snapshot.schema.json"},
    "control_definitions": {"type": "array", "items": {"$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v1:control-definition.schema.json"}},
    "findings": {"type": "array", "items": {"$ref": "urn:ai-marketing-hub:claude-ads:schema:core:v2:finding.schema.json"}},
    "scoring": {
      "type": "object",
      "required": ["health_score", "evidence_coverage", "status", "categories"],
      "properties": {
        "health_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "evidence_coverage": {"type": "number", "minimum": 0, "maximum": 100},
        "status": {"enum": ["normal", "provisional", "insufficient_evidence"]},
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "category_weight",
              "health_score",
              "evidence_coverage",
              "applicable_controls",
              "known_controls",
              "passed_controls",
              "failed_controls",
              "unknown_controls"
            ],
            "properties": {
              "category": {"type": "string", "minLength": 1},
              "category_weight": {"type": "number", "minimum": 0, "maximum": 100},
              "health_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
              "evidence_coverage": {"type": "number", "minimum": 0, "maximum": 100},
              "applicable_controls": {"type": "integer", "minimum": 0},
              "known_controls": {"type": "integer", "minimum": 0},
              "passed_controls": {"type": "integer", "minimum": 0},
              "failed_controls": {"type": "integer", "minimum": 0},
              "unknown_controls": {"type": "integer", "minimum": 0}
            },
            "allOf": [
              {
                "if": {"properties": {"known_controls": {"const": 0}}},
                "then": {"properties": {"health_score": {"const": null}}}
              },
              {
                "if": {"properties": {"known_controls": {"minimum": 1}}},
                "then": {"properties": {"health_score": {"type": "number"}}}
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["run_manifest"],
        "properties": {
          "run_manifest": {
            "required": ["completeness"],
            "properties": {"completeness": {"const": "complete"}}
          }
        }
      },
      "then": {
        "properties": {
          "control_definitions": {"minItems": 1},
          "findings": {"minItems": 1},
          "run_manifest": {
            "properties": {
              "worker_status": {
                "minProperties": 1,
                "additionalProperties": {"const": "completed"}
              }
            }
          },
          "scoring": {
            "properties": {"status": {"not": {"const": "insufficient_evidence"}}}
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
